    {
      "id": "VkIrQxlIueLO6SnjXRLLH",
      "type": "text",
      "x": 57.40747868076528,
      "y": 149.70653634372974,
      "width": 267.96728515625,
      "height": 68.32273244526323,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1R",
      "roundness": null,
      "seed": 604737309,
      "version": 423,
      "versionNonce": 2116311457,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787982406093,
      "link": null,
      "locked": false,
      "text": "Constraints\n1. TypeX machine can only be serviced by CatA people\n2. This machien can only be serviced onsite\n3. I need a helicopter to reach this equipment\n4. I cannot outsource to vendor the maintenacen of equip X\n5. I cannot spend more than 500k USD per month",
      "fontSize": 9.10969765936843,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Constraints\n1. TypeX machine can only be serviced by CatA people\n2. This machien can only be serviced onsite\n3. I need a helicopter to reach this equipment\n4. I cannot outsource to vendor the maintenacen of equip X\n5. I cannot spend more than 500k USD per month",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "c6frbDKncwcaPClMKXk5-",
      "type": "text",
      "x": 53.69959545236708,
      "y": 254.23396049356063,
      "width": 286.38568115234375,
      "height": 56.93561037105269,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
