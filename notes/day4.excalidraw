      "text": "\n\n8-bit = 1 byte\n 0000 0010 -> 2\n0000 0001 -> 1\n0000 0000 -> 0\n0000 0010 - 2\nbit\nBoolean Mathematics",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
