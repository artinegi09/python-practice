      "seed": 1276500239,
      "version": 237,
      "versionNonce": 142491789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790917944430,
      "link": null,
      "locked": false,
      "text": "def SI(P,R,T):\n     A = (P * R * T)/100\n     return A\n\ndef Amount(P,SI):\n    return P+SI \n\ndef Amount2(P,R,T):\n    # write code here\n\nP = 100\nR = 5\nT = 4\n\nsi = SI(P,R,T)\namt = Amount(P,si)\nprint(amt)\nprint(si)\n\namt2 = Amount2(P,R,T)\nprint(amt2)\n\n*WAF that directly calculates the\nAmount using P,R,T",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "CmhHYY0ETClJG1jFYLCcU",
      "originalText": "def SI(P,R,T):\n     A = (P * R * T)/100\n     return A\n\ndef Amount(P,SI):\n    return P+SI \n\ndef Amount2(P,R,T):\n    # write code here\n\nP = 100\nR = 5\nT = 4\n\nsi = SI(P,R,T)\namt = Amount(P,si)\nprint(amt)\nprint(si)\n\namt2 = Amount2(P,R,T)\nprint(amt2)\n\n*WAF that directly calculates the Amount using P,R,T",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
