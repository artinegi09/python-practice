    {
      "id": "KDojgGFnSE9p5JnLGm4BP",
      "type": "text",
      "x": 3576.639906682712,
      "y": 2979.80506288204,
      "width": 408.8997497558594,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "bFe",
      "roundness": null,
      "seed": 722377409,
      "version": 231,
      "versionNonce": 685789827,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790917944430,
      "link": null,
      "locked": false,
      "text": "Similar to English or Human languages      \nPython\n    a = 10\n    print(\"Hello \" + 10)\nC++\n    int a = 10;\n    std::cout<<\"Hello\"<<a;\nC\n    int a = 10;\n    printf(\"%d\",10);\n\nASM",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Similar to English or Human languages      \nPython\n    a = 10\n    print(\"Hello \" + 10)\nC++\n    int a = 10;\n    std::cout<<\"Hello\"<<a;\nC\n    int a = 10;\n    printf(\"%d\",10);\n\nASM",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "RiZoqqHkqbMzLdX8mYvZ_",
      "type": "text",
      "x": 3682.6166671190254,
      "y": 3246.6954417736633,
      "width": 142.17667853196053,
      "height": 87.1549983984541,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 0,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "bFf",
      "roundness": null,
      "seed": 1393799137,
      "version": 432,
      "versionNonce": 300305197,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790917944430,
      "link": null,
      "locked": false,
      "text": "; goodbyeworld.s for C= 8-bit machines, ca65 assembler format.\n; String printing limited to strings of 256 characters or less.\n\na_cr        = $0d                ; Carriage return.\nbsout        = $ffd2                ; C64 KERNEL ROM, output a character to current device.\n                        ; use $fded for Apple 2, $ffe3 (ascii) or $ffee (raw) for BBC.\n        .code\n\n        ldx #0                ; Starting index 0 in X register.\nprintnext:\n        lda text,x        ; Get character from string.\n        beq done        ; If we read a 0 we're done.\n        jsr bsout        ; Output character. \n        inx                ; Increment index to next character.\n        bne printnext        ; Repeat if index doesn't overflow to 0.\ndone:\n        rts                ; Return from subroutine.\n\n        .rodata\n\ntext:\n        .byte        \"Hello world!\", a_cr, 0",
      "fontSize": 3.1692726690346955,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "; goodbyeworld.s for C= 8-bit machines, ca65 assembler format.\n; String printing limited to strings of 256 characters or less.\n\na_cr        = $0d                ; Carriage return.\nbsout        = $ffd2                ; C64 KERNEL ROM, output a character to current device.\n                        ; use $fded for Apple 2, $ffe3 (ascii) or $ffee (raw) for BBC.\n        .code\n\n        ldx #0                ; Starting index 0 in X register.\nprintnext:\n        lda text,x        ; Get character from string.\n        beq done        ; If we read a 0 we're done.\n        jsr bsout        ; Output character. \n        inx                ; Increment index to next character.\n        bne printnext        ; Repeat if index doesn't overflow to 0.\ndone:\n        rts                ; Return from subroutine.\n\n        .rodata\n\ntext:\n        .byte        \"Hello world!\", a_cr, 0",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
