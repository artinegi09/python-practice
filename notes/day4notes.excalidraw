      "text": "false true\n0 1\n\nLogical Operator \n\nAND roti veg = :-)\n        1     1  = 1\n        1     0 = 0\n        0    1  = 0\n        0    0 = 0\n\nOR burger pizza = :-)\n        1     1  = 1\n        0     1 = 1\n        1     0 = 1\n       0     0 = 0\n\nNOT\n1 = 0\n0 = 1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "daH7G8X0znLB68C6FofET",
      "originalText": "false true\n0 1\n\nLogical Operator \n\nAND roti veg = :-)\n        1     1  = 1\n        1     0 = 0\n        0    1  = 0\n        0    0 = 0\n\nOR burger pizza = :-)\n        1     1  = 1\n        0     1 = 1\n        1     0 = 1\n       0     0 = 0\n\nNOT\n1 = 0\n0 = 1",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
