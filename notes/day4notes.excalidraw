    },
    {
      "id": "HGQLF6l1SlD1y7PjtiiU5",
      "type": "text",
      "x": 4336.463663393927,
      "y": 3351.2136864505514,
      "width": 8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
