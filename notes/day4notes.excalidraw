    {
      "id": "hiLCK-y81Big72oVGPSoN",
      "type": "text",
      "x": 4612.602008241351,
      "y": 3412.949452486531,
      "width": 262.6397399902344,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 60,
      "groupIds": [],
      "frameId": null,
      "index": "bFx",
